---
/**
 * Homepage hero for Gleaner.
 *
 * Replaces the shared `Header` on `/` only, by way of the `header` slot that
 * `src/layouts/Layout.astro` forwards through to `Base.astro`. Every other
 * route falls back to that forwarded slot's default content, which is the
 * shared `Header` itself.
 *
 * Two columns that stack below about 60rem: the pitch with the install action
 * on the left, and on the right the example from the Gleaner README told as a
 * copper string. Each `GleanPart` is one plain-language ask, and the string
 * ties off in the logo's knot at the `SavedClip` those asks produced.
 *
 * Colours come from the Gleaner logo (evergreen #185C53, copper #C46B43), as
 * the `--g-*` and `--glean-*` properties `src/styles/gleaner-palette.css` sets
 * on `[data-gleaner]` for both themes. None of them is the site's `--island`
 * accent, so the homepage's accent audit in
 * `e2e/homepage-design-direction.spec.ts` still holds.
 *
 * @component HomeHero
 * @example
 * ```astro
 * <!-- The slot name is required: without it the hero renders into the page
 *      body and the shared Header stays at the top of the document. -->
 * <Layout pageTitle={SITE_TITLE}>
 *   <HomeHero slot="header" />
 * </Layout>
 * ```
 */
import GleanPart from '#components/astro/GleanPart.astro'
import SavedClip from '#components/astro/SavedClip.astro'
import '#styles/gleaner-palette.css'

export type Props = {
  /** Mono eyebrow set above the headline. */
  eyebrow?: string
  /** Display headline. Rendered as the page's single `h1`. */
  headline?: string
  /** Deck paragraph under the headline. */
  deck?: string
}

const {
  eyebrow = 'A Claude plugin for Chrome and Claude Code',
  headline = 'Gather the best of what you read.',
  deck = 'Ask Claude in plain words to keep a page, a passage, a YouTube moment or its own answer. Gleaner writes a short summary, tags it, and files it in Google Drive, Notion or your project. Later, ask what you saved and it finds it.',
} = Astro.props as Props

const repo = 'https://github.com/shawn-sandy/gleaner'
---

<header class="home-hero" data-home-hero data-gleaner>
  <div class="home-hero__lede">
    <p class="home-hero__eyebrow" data-ui="eyebrow">{eyebrow}</p>
    <h1 class="home-hero__display" data-ui="display">{headline}</h1>
    <p class="home-hero__deck">{deck}</p>

    <div class="home-hero__cta">
      <a class="home-hero__button" href={`${repo}#install`}>
        Install Gleaner
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18">
          <path
            d="M5 12h14M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <!-- Root-relative rather than a bare `#how`: the CTA check in
           e2e/homepage-design-direction.spec.ts follows every `/` link the hero
           has, and on this page the browser still treats it as a same-page jump. -->
      <a class="home-hero__link" href="/#how">See it in action</a>
    </div>

    <div class="home-hero__install">
      <p class="home-hero__install-label">In Claude Code</p>
      <pre
        class="home-hero__code"><code>/plugin marketplace add shawn-sandy/gleaner
/plugin install gleaner@shawn-sandy</code></pre>
    </div>

    <p class="home-hero__fine">
      Saves to <strong>Google Drive</strong>, <strong>Notion</strong>, a <strong
        >Cowork project</strong
      >, your <strong>Claude Code project</strong> or a private <strong>claude.ai artifact</strong>.
    </p>
    <p class="home-hero__fine">
      Open source, MIT. Needs a paid Claude plan with the Chrome side panel.
    </p>
  </div>

  <section class="home-hero__example" id="how" aria-labelledby="home-hero-example-title">
    <h2 class="home-hero__example-title" id="home-hero-example-title">
      Example: three asks, one clip
    </h2>
    <ol class="home-hero__thread">
      <GleanPart
        ask="grab the part about animation lengths, for the motion post"
        reply="Added part 1: animation lengths."
      >
        <p class="home-hero__passage">
          <mark
            >Keep most UI transitions short: around 200 to 300 ms feels quick without feeling
            abrupt.</mark
          >
        </p>
      </GleanPart>
      <GleanPart ask="and this table too" reply="Added part 2: this table.">
        <table class="home-hero__table">
          <caption>Duration by element size</caption>
          <tbody>
            <tr><td>Small: icons, toggles</td><td>100–150 ms</td></tr>
            <tr><td>Medium: cards, menus</td><td>200–300 ms</td></tr>
            <tr><td>Large: sheets, pages</td><td>300–400 ms</td></tr>
          </tbody>
        </table>
      </GleanPart>
      <GleanPart ask="done" />
      <SavedClip
        title="Motion timing guidelines"
        summary="Two parts on picking durations by element size."
        tags={['#motion', '#animation', '#css-transitions']}
        destination="Google Drive › Browser Research / Design Engineering"
      />
    </ol>
  </section>
</header>

<style>
  /* Plus Jakarta Sans, the wordmark's face. Same declaration as
     `Navigation.astro`, repeated so the hero renders right on its own; the
     browser fetches the one URL once. */
  @font-face {
    font-display: swap;
    font-family: 'Plus Jakarta Sans';
    font-style: normal;
    font-weight: 200 800;
    src: url('/fonts/plus-jakarta-sans-wght.woff2') format('woff2');
  }

  .home-hero {
    /* Colours are the `[data-gleaner]` palette in gleaner-palette.css. */
    --glean-gutter: 3.5rem;
    --glean-gap: 1.25rem;

    /*
     * The deck follows the headline so the display-to-deck ratio the design
     * direction test asks for (3.0 or more) holds at every width: 3.4 at
     * 1280px, and exactly 3.0 at the 48px / 16px floors on a phone.
     */
    --hero-display-size: clamp(3rem, 5.4vw, 4.875rem);
    --hero-deck-size: clamp(1rem, calc(var(--hero-display-size) / 3.4), 1.375rem);

    align-items: flex-start;
    background-color: var(--g-ground);
    box-sizing: border-box;
    color: var(--g-ink);
    display: flex;
    flex-wrap: wrap;
    gap: 3.5rem 5rem;

    /*
     * Undoes the @fpkit/acss overlay pattern every `header` gets (a single
     * "overlay" grid area, a 300px row floor, `min-height: 40vh` and a 20rem
     * `min-width` that overflowed a 320px viewport).
     */
    grid-template-areas: none;
    grid-template-rows: auto;
    min-height: fit-content;
    min-width: 0;
    padding-block: 4rem 5.5rem;

    /* Full-bleed band, content held to the page measure. */
    padding-inline: max(1.25rem, calc((100% - var(--max-content-width, 80rem)) / 2));
    width: 100%;
  }

  .home-hero > .home-hero__lede,
  .home-hero > .home-hero__example {
    display: block;
    gap: normal;
    grid-area: auto;
    margin-inline: 0;
    min-width: 0;
    padding-inline: 0;
    text-align: left;
  }

  .home-hero > .home-hero__lede {
    flex: 1 1 28rem;
    max-width: 40rem;
  }

  .home-hero > .home-hero__example {
    flex: 1 1 28rem;
    max-width: 36rem;
  }

  .home-hero .home-hero__eyebrow,
  .home-hero .home-hero__example-title {
    color: var(--g-muted);
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .home-hero .home-hero__eyebrow {
    margin: 0 0 1.375rem;
    max-width: none;
  }

  .home-hero .home-hero__display {
    color: var(--g-headline);
    font-family: 'Plus Jakarta Sans', var(--font-family-display, sans-serif);
    font-size: var(--hero-display-size);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin: 0;
    overflow-wrap: break-word;
    text-align: left;
    text-transform: none;
    text-wrap: balance;
  }

  .home-hero .home-hero__deck {
    font-family: var(--font-family-sans, sans-serif);
    font-size: var(--hero-deck-size);
    line-height: 1.55;
    margin: 1.75rem 0 0;
    max-width: 34em;
  }

  .home-hero .home-hero__cta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-block-start: 2.25rem;
  }

  .home-hero .home-hero__button {
    align-items: center;
    background-color: var(--g-button-bg);
    border-radius: 999px;
    box-sizing: border-box;
    color: var(--g-button-ink);
    display: inline-flex;
    font-family: 'Plus Jakarta Sans', var(--font-family-sans, sans-serif);
    font-size: 1.0625rem;
    font-weight: 650;
    gap: 0.625rem;
    min-height: 3.25rem;
    padding: 0 1.625rem;
    text-decoration: none;

    /* Colour only, so there is no motion to suppress for reduced motion. */
    transition: background-color 150ms ease-out;
  }

  .home-hero .home-hero__button:hover {
    background-color: var(--g-button-hover);

    /* A cue that does not rely on colour alone. */
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .home-hero .home-hero__link {
    align-items: center;
    color: var(--g-link);
    display: inline-flex;
    font-size: 1.0625rem;
    font-weight: 600;
    min-height: 44px;
    text-underline-offset: 5px;
  }

  .home-hero .home-hero__button:focus-visible,
  .home-hero .home-hero__link:focus-visible {
    outline: 2px solid var(--g-headline);
    outline-offset: 3px;
  }

  .home-hero .home-hero__install {
    background-color: var(--g-code-bg);
    border-radius: 0.75rem;
    margin-block-start: 2.25rem;
    max-width: 30rem;
    padding: 0.875rem 1.125rem;
  }

  .home-hero .home-hero__install-label {
    color: var(--g-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.5rem;
  }

  /* Wraps instead of scrolling, so a 320px screen needs no scroll box. */
  .home-hero .home-hero__code {
    background: none;
    border: 0;
    color: var(--g-code-ink);
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 0.875rem;
    line-height: 1.7;
    margin: 0;
    overflow-wrap: anywhere;
    padding: 0;
    white-space: pre-wrap;
  }

  .home-hero .home-hero__code code {
    background: none;
    color: inherit;
    font: inherit;
    padding: 0;
  }

  .home-hero .home-hero__fine {
    color: var(--g-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0.5rem 0 0;
  }

  .home-hero .home-hero__fine:first-of-type {
    margin-block-start: 1.75rem;
  }

  .home-hero .home-hero__fine strong {
    color: var(--g-ink);
    font-weight: 600;
  }

  .home-hero .home-hero__example-title {
    margin: 0 0 1.125rem var(--glean-gutter);
  }

  .home-hero .home-hero__thread {
    display: flex;
    flex-direction: column;
    gap: var(--glean-gap);
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--glean-gutter);
  }

  /* Captured content inside each GleanPart. Authored here, so styled here. */
  .home-hero .home-hero__passage {
    font-size: 1.0625rem;
    line-height: 1.5;
    margin: 0.875rem 0 0;
    max-width: none;
  }

  .home-hero .home-hero__passage mark {
    background-color: var(--glean-mark-bg);
    border-radius: 0.25rem;
    box-decoration-break: clone;
    color: var(--glean-mark-ink);
    padding: 0.125rem 0.25rem;
  }

  .home-hero .home-hero__table {
    background-color: var(--glean-mark-bg);
    border-collapse: collapse;
    color: var(--glean-mark-ink);
    font-size: 0.9375rem;
    line-height: 1.4;
    margin: 0.875rem 0 0;
    width: 100%;
  }

  .home-hero .home-hero__table caption {
    color: var(--glean-ink);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0 0 0.5rem;
    text-align: left;
  }

  .home-hero .home-hero__table td {
    border: 0;
    padding: 0.5rem 0.75rem;
  }

  .home-hero .home-hero__table tr + tr td {
    border-block-start: 1px solid var(--glean-mark-rule);
  }

  .home-hero .home-hero__table td:last-child {
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 0.875rem;
    text-align: right;
    white-space: nowrap;
  }

  /*
   * The theme toggle. Repaints the surface itself, because
   * `:root[data-theme='dark'] body > header` in the site stylesheet paints
   * every header and outranks a lone class.
   */
  :global(:root[data-theme='dark']) .home-hero {
    background-color: var(--g-ground);
    color: var(--g-ink);
  }

  @media (max-width: 30rem) {
    .home-hero {
      --glean-gutter: 2.75rem;

      padding-block: 3rem 4rem;
    }
  }
</style>
