---
import { SITE_TITLE } from '#utils/site-config'

/**
 * Primary site navigation.
 * @component Navigation
 * @example
 * ```astro
 * <Navigation brandTitle="Docs" brandHref="/guide/" menuId="docs-nav-popover">
 *   <ul data-nav-account><li><a href="/dashboard">Dashboard</a></li></ul>
 *   <ul slot="login"><li><button type="button">Sign in</button></li></ul>
 * </Navigation>
 * ```
 *
 * The link list lives inside a native HTML popover panel toggled by a
 * hamburger button. Open/close, Esc-to-close and outside-click ("light
 * dismiss") are provided by the browser via the `popover` /
 * `popovertarget` attributes — this component ships no JavaScript.
 *
 * The root `nav` carries `data-site-nav`. Every selector in
 * `_navigation.scss` and in the inline first-paint block below is scoped to
 * it, so the styles cannot reach a consumer's own popover navigation.
 *
 * The popover is presentational only. It must never be used to gate
 * authenticated content: markup inside `[popover]` is present in the HTML
 * response whether the panel is open or not.
 */
export type Props = {
  /** Text of the brand link on the left of the bar. */
  brandTitle?: string
  /** Destination of the brand link. */
  brandHref?: string
  /** id of the popover panel, wired to the button's `popovertarget`. */
  menuId?: string
  /** Render the brand link. Set false when a consumer supplies its own. */
  showBrand?: boolean
  /**
   * Render the hamburger button. Set false to park the menu: the panel still
   * renders, closed and unreachable, because the bar's row layout in
   * `_navigation.scss` keys off `:has(> [popover])`.
   */
  showMenu?: boolean
}

const {
  brandTitle = SITE_TITLE,
  brandHref = '/',
  menuId = 'site-nav-popover',
  showBrand = true,
  showMenu = true,
} = Astro.props
---

<!--
  The site stylesheet is injected by JS in dev, so the browser paints the UA's
  native button chrome (40x33, grey, 2px border) for a frame before the nav
  styles land. `is:inline` keeps this block in the HTML, so the first paint
  already matches the final one. Only the declarations that change the painted
  box are repeated here; hover, focus and open states stay in
  `_navigation.scss`. Specificity is (0,2,2) against that file's (0,3,2), so
  those rules still win. A fade-in cannot fix this - it would have to live in
  the same late stylesheet.

  `[data-site-nav]` scopes the rule to this component. `Navigation` is
  exported from the package, so a bare `nav > button[popovertarget]` would
  reach a consumer's own popover nav on the same page.

  The `@supports` guard scopes the block to engines that actually get a
  popover. Without a popover the button is inert, and `_navigation.scss`
  hides it under `@supports not selector(:popover-open)`. That block now
  states each selector as its own rule, and its bare form is (0,2,2) - an
  exact tie with this one. This block sits in `<body>`, after every
  stylesheet in `<head>`, so it would win that tie on source order and the
  inert button would reappear. The guard removes the tie instead of
  relying on it: with no popover, this block simply does not apply.
-->
<style is:inline>
  @supports selector(:popover-open) {
    nav[data-site-nav] > button[popovertarget] {
      align-items: center;
      appearance: none;
      background: transparent;
      /* Transparent border and background make the radius invisible, so
         `--card-radius` is not needed before the stylesheet lands. */
      border: 1px solid transparent;
      /* The SVG strokes with `currentColor`. Without this the icon paints in
         the UA's `buttontext` system colour rather than the page's. */
      color: inherit;
      display: inline-flex;
      justify-content: center;
      /* Mirrors --space-11; the token is defined in the late stylesheet. */
      min-height: 44px;
      min-width: 44px;
      padding: 0;
    }
  }
</style>

<nav aria-label="Primary" data-site-nav>
  {
    showMenu && (
      <button type="button" popovertarget={menuId} aria-label="Menu">
        <svg
          aria-hidden="true"
          focusable="false"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </svg>
      </button>
    )
  }

  {
    showBrand && (
      <a href={brandHref} data-nav-brand>
        {/* Decorative: the link's name is the brand title beside it. */}
        <img src="/images/gleaner-symbol.svg" alt="" width="44" height="44" />
        {brandTitle}
      </a>
    )
  }

  <div id={menuId} popover="auto">
    <ul>
      <li>
        <a href="/">Home</a>
      </li>
      <li>
        <a href="/content/1">Articles</a>
      </li>
      <li>
        <a href="/posts/1">Blog</a>
      </li>
      <li>
        <a href="/about">About</a>
      </li>
      <li>
        <a href="/contact">Contact</a>
      </li>
    </ul>
    <slot />
  </div>

  <slot name="login" />
</nav>

<style>
  /* Room above and below the 60px brand. The attribute outranks acss's
     `body > nav { padding-block: unset }` on narrow screens. `body` is a flex
     column and acss's explicit `min-height: 4rem` replaces the content-sized
     floor, so without `flex-shrink: 0` the 84px bar is squeezed back to 64px
     and the padding collapses into the brand. */
  [data-site-nav] {
    flex-shrink: 0;
    padding-block: var(--space-3);
  }

  /* Layout and face only. Weight and underline stay in `_navigation.scss`.
     The symbol is a white hand on its own evergreen disc and reads on both
     themes; the name matches that disc (see `[href]` below). */
  [data-nav-brand] {
    align-items: center;
    display: inline-flex;
    font-family: 'Plus Jakarta Sans', var(--font-family-sans, sans-serif);
    gap: 0.5rem;
    letter-spacing: -0.01em;
    min-height: 44px;
  }

  /* Tops out at 1.875rem, a 60px symbol that still fits the 4rem bar, from
     about 440px wide, and holds at 1.375rem below about 400px. The slope
     keeps the brand inside what the toggle, gaps and theme button leave of
     the bar (e2e: no horizontal overflow at 390px). `[href]` lifts the size
     and colour above the site's `a[href]` link rule, which a lone attribute
     would lose to under Astro's `:where()` scoping; without it that rule
     paints the brand in `--link-color` teal. The colour is the evergreen
     fill of `gleaner-symbol.svg`'s disc, fixed in both themes like the
     symbol itself. */
  [data-nav-brand][href] {
    color: #185c53;
    font-size: clamp(1.375rem, 15vw - 2.25rem, 1.875rem);
  }

  /* Below 360px the toggle, the brand and the account links only fit on one
     bar with the brand at 1rem, so it returns to that size there rather than
     widen the page (e2e: no horizontal overflow at 320px). */
  @media (max-width: 22.5rem) {
    [data-nav-brand][href] {
      font-size: 1rem;
    }
  }

  /* Twice the text height at any size, the proportion `gleaner-wordmark.svg`
     draws the symbol and the name at. */
  [data-nav-brand] img {
    display: block;
    flex: none;
    height: 2em;
    width: 2em;
  }
</style>
