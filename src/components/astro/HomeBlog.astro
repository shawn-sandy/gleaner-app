---
/**
 * The homepage blog section, under the quick-install guide: the newest
 * published post as an evergreen feature card, up to three earlier posts as
 * one-line rows, and a link to every post. Renders nothing until a post is
 * published.
 *
 * The posts set `data-gleaner`, so they paint the Gleaner palette; the heading
 * and intro stay outside it, on the site's own type, as `HomeInstall`'s do.
 * The feature card uses the `--glean-clip-*` evergreen, which reads on either
 * theme's ground.
 *
 * @component HomeBlog
 * @example
 * ```astro
 * <HomeInstall />
 * <HomeBlog />
 * ```
 */
import { getPublishedPosts } from '#utils/home-sections'
import '#styles/gleaner-palette.css'

/** Takes no props: the posts come from the `posts` collection. */
export type Props = Record<string, never>

/** The feature card plus the earlier rows under it. */
const POST_LIMIT = 4

const [latest, ...earlier] = (await getPublishedPosts())
  // Posts with the same `pubDate` fall back to their id, so the order never
  // depends on the order the collection happens to return.
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || a.id.localeCompare(b.id))
  .slice(0, POST_LIMIT)

// `pubDate: 2026-10-21` parses to midnight UTC, so the day is read in UTC; in
// the build machine's zone a western server would print October 20.
const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' })

/** A post's day as a `<time>` value and its printed label. */
const day = (date: Date) => ({
  iso: date.toISOString().slice(0, 10),
  label: dateFormat.format(date),
})
---

{
  latest && (
    <section class="home-blog" id="blog" aria-labelledby="home-blog-title">
      <div class="home-blog__head">
        <h2 class="home-blog__title" id="home-blog-title">
          From the blog
        </h2>
        <p class="home-blog__lede">
          What changed in each Gleaner release, and how to install or update.
        </p>
      </div>

      <div class="home-blog__body" data-gleaner>
        <article class="home-blog__latest" aria-labelledby="home-blog-latest">
          <p class="home-blog__meta">
            <span class="home-blog__eyebrow">Latest</span>
            <time datetime={day(latest.data.pubDate).iso}>{day(latest.data.pubDate).label}</time>
          </p>
          <h3 class="home-blog__latest-title" id="home-blog-latest">
            {latest.data.title}
          </h3>
          <p class="home-blog__latest-text">{latest.data.description}</p>
          <a
            class="home-blog__read"
            href={`/posts/${latest.id}`}
            aria-describedby="home-blog-latest"
          >
            Read the post
            <svg
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14" />
              <path d="m13 6 6 6-6 6" />
            </svg>
          </a>
        </article>

        {earlier.length > 0 && (
          <div>
            <p class="home-blog__label" id="home-blog-earlier">
              Earlier posts
            </p>
            <ul class="home-blog__list" role="list" aria-labelledby="home-blog-earlier">
              {earlier.map(post => (
                <li class="home-blog__row">
                  <time class="home-blog__date" datetime={day(post.data.pubDate).iso}>
                    {day(post.data.pubDate).label}
                  </time>
                  <div class="home-blog__summary">
                    <h3 class="home-blog__name">
                      <a href={`/posts/${post.id}`}>{post.data.title}</a>
                    </h3>
                    <p class="home-blog__text">{post.data.description}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}

        <a class="home-blog__all" href="/blog">
          All posts
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </a>
      </div>
    </section>
  )
}

<style>
  /* Two classes throughout: Astro scopes with `:where()`, so a lone class
     would lose to the site's own heading, list and link rules. */
  .home-blog {
    display: flex;
    flex-direction: column;
    font-family: var(--font-family-sans, sans-serif);
    gap: 2rem;
    padding-block: 2rem 3rem;
  }

  .home-blog .home-blog__head {
    max-width: 40rem;
  }

  /* Outside `[data-gleaner]`, so the face, weight and colour are the site's
     heading rules; only the size and case are set here, as in HomeInstall. */
  .home-blog .home-blog__title {
    font-size: clamp(1.625rem, 4vw, 2.125rem);
    line-height: 1.15;
    margin: 0;
    text-transform: none;
  }

  .home-blog .home-blog__lede {
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0.75rem 0 0;
    max-width: none;
  }

  .home-blog .home-blog__body {
    color: var(--g-ink, #12302b);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .home-blog .home-blog__latest {
    align-items: flex-start;
    background: var(--glean-clip-bg, #185c53);
    border-radius: 1rem;
    color: var(--glean-clip-ink, #fff);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .home-blog .home-blog__meta {
    align-items: baseline;
    color: var(--glean-clip-muted, #cfe5de);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.9375rem;
    gap: 0.75rem;
    margin: 0;
    max-width: none;
  }

  .home-blog .home-blog__eyebrow,
  .home-blog .home-blog__label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .home-blog .home-blog__latest-title {
    color: var(--glean-clip-ink, #fff);
    font-family: 'Plus Jakarta Sans', var(--font-family-display, sans-serif);
    font-size: clamp(1.75rem, 4vw, 2.375rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
    max-width: 44rem;
    text-transform: none;
  }

  .home-blog .home-blog__latest-text {
    color: var(--glean-clip-muted, #cfe5de);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0;
    max-width: 44rem;
  }

  .home-blog .home-blog__read {
    align-items: center;
    background: var(--glean-clip-ink, #fff);
    border-radius: 0.5rem;
    box-sizing: border-box;
    color: var(--glean-clip-bg, #185c53);
    display: inline-flex;
    font-weight: 700;
    gap: 0.375rem;
    margin-block-start: 0.5rem;
    min-height: 44px;
    padding: 0.625rem 1.125rem;
    text-decoration: none;
  }

  .home-blog .home-blog__read:hover {
    background: var(--glean-clip-muted, #cfe5de);
  }

  /* The site's focus ring is drawn for the page ground; on the evergreen card
     it takes the card's own ink. */
  .home-blog .home-blog__read:focus-visible {
    outline: 2px solid var(--glean-clip-ink, #fff);
    outline-offset: 3px;
  }

  .home-blog .home-blog__label {
    color: var(--g-muted, #4a615c);
    margin: 0 0 0.5rem;
    max-width: none;
  }

  /* Rules between rows; clear the @fpkit/acss `li` margin and indent, as every
     Gleaner list does (`e2e/home-gleaner-lists.spec.ts`). */
  .home-blog .home-blog__list {
    border-block-start: 1px solid var(--glean-border, #d5e3de);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The date sits beside the title while the summary keeps 20rem, above it
     below that. */
  .home-blog .home-blog__row {
    border-block-end: 1px solid var(--glean-border, #d5e3de);
    column-gap: 2rem;
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 1.25rem 0;
    row-gap: 0.25rem;
  }

  .home-blog .home-blog__date {
    color: var(--g-muted, #4a615c);
    flex: 0 0 8.5rem;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    padding-block-start: 0.125rem;
  }

  .home-blog .home-blog__summary {
    flex: 999 1 20rem;
    min-width: 0;
  }

  .home-blog .home-blog__name {
    font-family: 'Plus Jakarta Sans', var(--font-family-display, sans-serif);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0;
    text-transform: none;
  }

  /* The site's `a` rule sets its own size and weight, which would set the
     title in 16px/400 inside its 18px/700 heading. */
  .home-blog .home-blog__name a {
    font: inherit;
  }

  .home-blog .home-blog__name a,
  .home-blog .home-blog__all {
    color: var(--g-link, #185c53);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* One line per row: the post itself carries the whole description. */
  .home-blog .home-blog__text {
    color: var(--g-muted, #4a615c);
    font-size: 0.9375rem;
    margin: 0.25rem 0 0;
    max-width: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-blog .home-blog__all {
    align-items: center;
    align-self: flex-start;
    display: inline-flex;
    font-weight: 600;
    gap: 0.375rem;
    min-height: 44px;
  }
</style>
