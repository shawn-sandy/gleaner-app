---
/**
 * The homepage quick-install guide: two columns, one for Claude and one for
 * ChatGPT, collapsing to one column on narrow screens.
 *
 * Steps follow the Gleaner README's Install section (Claude) and its
 * `docs/chatgpt-marketplace.md` (ChatGPT). Sets `data-gleaner` itself, so it
 * paints the Gleaner palette wherever it is used.
 *
 * @component HomeInstall
 * @example
 * ```astro
 * <Layout pageTitle={SITE_TITLE} hideSidebar>
 *   <HomeInstall />
 * </Layout>
 * ```
 */
import '#styles/gleaner-palette.css'

/** Takes no props: the section is fixed homepage copy. */
export type Props = Record<string, never>

const repo = 'https://github.com/shawn-sandy/gleaner'
---

<section class="home-install" data-gleaner aria-labelledby="home-install-title">
  <div class="home-install__head">
    <h2 class="home-install__title" id="home-install-title">Quick install</h2>
    <p class="home-install__lede">
      Claude and ChatGPT both install Gleaner from the same GitHub marketplace, <code
        >shawn-sandy/gleaner</code
      >.
    </p>
  </div>

  <div class="home-install__cols">
    <div class="home-install__card">
      <h3 class="home-install__name">Claude</h3>
      <p class="home-install__where">Chrome side panel, Cowork and Claude Code</p>
      <ol class="home-install__steps">
        <li>
          Open <strong>Customize → Plugins</strong>, then choose <strong
            >Add → Add marketplace</strong
          >.
        </li>
        <li>Enter <code>shawn-sandy/gleaner</code>.</li>
        <li>Install <strong>Gleaner</strong>. It's in the Chrome side panel right away.</li>
        <li>Open a page and say <code>save this page</code>.</li>
      </ol>
      <p class="home-install__label">In Claude Code</p>
      <pre
        class="home-install__code"><code>/plugin marketplace add shawn-sandy/gleaner
/plugin install gleaner@shawn-sandy</code></pre>
      <p class="home-install__needs">
        Needs a paid Claude plan with the new Chrome side panel, and the Google Drive connector for
        the default save location.
      </p>
      <a class="home-install__more" href={`${repo}#install`}>Full Claude install guide</a>
    </div>

    <div class="home-install__card">
      <h3 class="home-install__name">ChatGPT</h3>
      <p class="home-install__where">Connected Chrome tabs and the Work browser</p>
      <ol class="home-install__steps">
        <li>
          In your workspace's <strong>Plugins</strong> settings, choose the GitHub marketplace import.
        </li>
        <li>Enter <code>{repo}</code>.</li>
        <li>
          Enable <strong>Gleaner</strong> for your workspace members, then install it in a new chat.
        </li>
        <li>
          Connect Google Drive to save clips there. Browser access and Notion are separate
          connections.
        </li>
        <li>Open a tab or paste a URL and say <code>save this page</code>.</li>
      </ol>
      <p class="home-install__needs">
        Needs a workspace with marketplace import enabled. Menus and import permissions depend on
        your workspace's admin policy.
      </p>
      <a class="home-install__more" href={`${repo}/blob/main/docs/chatgpt-marketplace.md`}
        >ChatGPT setup and compatibility</a
      >
    </div>
  </div>
</section>

<style>
  /* Two classes throughout: Astro scopes with `:where()`, so a lone class
     would lose to the site's own heading, list, code and link rules. */
  .home-install {
    color: var(--g-ink, #12302b);
    display: flex;
    flex-direction: column;
    font-family: var(--font-family-sans, sans-serif);
    gap: 2.5rem;
    padding-block: 2rem 3rem;
  }

  .home-install .home-install__head {
    max-width: 40rem;
  }

  .home-install .home-install__title {
    color: var(--g-headline, #185c53);
    font-family: 'Plus Jakarta Sans', var(--font-family-display, sans-serif);
    font-size: clamp(1.625rem, 4vw, 2.125rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;

    /* A sentence, not a title: the site capitalises every h2 and h3. */
    text-transform: none;
  }

  .home-install .home-install__lede {
    color: var(--g-muted, #4a615c);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0.75rem 0 0;
    max-width: none;
  }

  /* Two columns while each can keep 22rem, one below that. */
  .home-install .home-install__cols {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .home-install .home-install__card {
    background: var(--g-card, #f5f8f6);
    border: 1px solid var(--glean-border, #d5e3de);
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .home-install .home-install__name {
    color: var(--g-headline, #185c53);
    font-family: 'Plus Jakarta Sans', var(--font-family-display, sans-serif);
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }

  .home-install .home-install__where {
    color: var(--g-muted, #4a615c);
    margin: 0.375rem 0 0;
    max-width: none;
  }

  .home-install .home-install__steps {
    line-height: 1.6;
    margin: 1.25rem 0 0;
    padding-inline-start: 1.25rem;
  }

  .home-install .home-install__steps li {
    margin: 0 0 0.5rem;
  }

  .home-install code {
    background: var(--g-code-bg, #e3efeb);
    border-radius: 0.375rem;
    color: var(--g-code-ink, #185c53);
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 0.875em;
    overflow-wrap: anywhere;
    padding: 0.0625rem 0.375rem;
  }

  .home-install .home-install__label {
    font-weight: 700;
    margin: 1rem 0 0.5rem;
  }

  /* Wraps rather than scrolls at phone width; the copied text keeps one
     command per line. */
  .home-install .home-install__code {
    background: var(--g-code-bg, #e3efeb);
    border-radius: 0.5rem;
    margin: 0;
    padding: 0.875rem 1rem;
    white-space: pre-wrap;
  }

  .home-install .home-install__code code {
    background: none;
    display: block;
    line-height: 1.6;
    padding: 0;
  }

  .home-install .home-install__needs {
    color: var(--g-muted, #4a615c);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 1.25rem 0 0;
    max-width: none;
  }

  /* Pinned to the card's foot, so the two links line up. */
  .home-install .home-install__more {
    align-self: flex-start;
    color: var(--g-link, #185c53);
    font-weight: 600;
    margin-block-start: auto;
    padding-block-start: 1rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
