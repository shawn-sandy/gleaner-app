---
/**
 * The homepage feature section under the Gleaner hero: the four skills, what
 * every clip gets (the README's sample clip with numbered callouts), and the
 * places a clip can be saved.
 *
 * Built from the "Gleaner feature section" design canvas. All copy follows the
 * Gleaner README and skills README; the sample clip is the README's own and is
 * captioned "Example". A full-bleed band on the hero's measure that sets
 * `data-gleaner` itself, so it paints the Gleaner palette wherever it is used.
 *
 * @component HomeFeatures
 * @example
 * ```astro
 * <Layout pageTitle={SITE_TITLE}>
 *   <HomeHero slot="header" />
 *   <div slot="featured"><HomeFeatures /></div>
 * </Layout>
 * ```
 */
import SkillCard from '#components/astro/SkillCard.astro'
import '#styles/gleaner-palette.css'

/** Takes no props: the section is fixed homepage copy. */
export type Props = Record<string, never>

const repo = 'https://github.com/shawn-sandy/gleaner'

const skills = [
  {
    name: 'glean',
    title: 'Pages, parts and answers',
    description:
      'Save a whole page, gather passages from several tabs into one clip, or keep the answer you got about a page, steps and code intact.',
    asks: ['save this page', 'grab the part about easing', 'save that'],
  },
  {
    name: 'youtube',
    title: 'Videos and the moments in them',
    description:
      "Save a video as a summary built from its transcript, read from YouTube's own transcript panel in your Chrome, or else from its description, with its channel, its useful links and key moments that link to the exact second. Clip just the moments that matter, or paste the transcript where the panel can't be read.",
    asks: ['save this video', 'keep 3:10 to 5:40', 'grab the part about generics'],
  },
  {
    name: 'preferences',
    title: 'Where clips go, set once',
    description:
      'Run setup once to choose where clips go and in what format. Pages and videos share these settings, which can sync through Google Drive if you want.',
    asks: ['always save here', 'use markdown by default', 'show my preferences'],
  },
  {
    name: 'follow-up',
    title: 'What to do next with a clip',
    description:
      'Ask what to do next with a saved clip. Gleaner reads its note, summary and links, then suggests three follow-ups and saves them to the clip.',
    asks: [
      'what should I follow up on?',
      'suggest follow-ups for that clip',
      'suggest follow-ups for my view transitions clip',
    ],
  },
]

/** What each numbered line of the sample clip shows. Order matches the markers. */
const callouts = [
  {
    title: 'Search by asking',
    body: 'Ask "what did I save about Cowork?" to get a table of matching stored clips, newest first, each linked. Gleaner searches titles, tags, notes and summaries. A clip left in the chat isn\'t stored, so it won\'t turn up.',
  },
  {
    title: 'One clip per page',
    body: 'Add more from a page you clipped this session, and it joins that clip. If the clip is from an earlier session, Gleaner saves an updated copy that links back. It never edits an old clip.',
  },
  {
    title: 'Filed for you',
    body: 'Each clip gets a category, which doubles as its folder, plus a type and 3 to 6 specific tags. Gleaner reuses the tags you already have, spelled the same way.',
  },
  {
    title: 'Your reasons, kept',
    body: 'Add a reason to any request, like "…for the motion post", and it\'s saved as the clip\'s note. Gleaner never writes one for you.',
  },
]

/** Destinations and their `--to` flags, as the README's flag table lists them. */
const destinations = [
  { name: 'This conversation', where: ['.md in ChatGPT, .html in Claude'], flag: '--to chat' },
  { name: 'Google Drive', where: ['Browser Research/', '<category>/'], flag: '--to drive' },
  { name: 'Notion', where: ['Browser Research database'], flag: '--to notion' },
  {
    name: 'Cowork project',
    where: ['browser-research/', '<category>/'],
    // The README's `--to cowork:"Project Name"`, shortened to fit one line.
    flag: '--to cowork:"Name"',
  },
  {
    name: 'Claude Code project',
    where: ['browser-research/', '<category>/'],
    flag: '--to local',
  },
  { name: 'Artifact', where: ['A private page on claude.ai'], flag: '--to artifact' },
]
---

<section class="home-features" data-gleaner aria-labelledby="home-features-title">
  <div class="home-features__inner">
    <div class="home-features__intro">
      <h2 class="home-features__title" id="home-features-title">
        Ask in plain words. Store it, find it again.
      </h2>
      <div class="home-features__lede">
        <p>
          Gleaner has four skills, and you never have to choose. Describe what you want, and Claude
          or ChatGPT picks the right one from your words and the page you're on.
        </p>
        <p class="home-features__muted">
          In Claude Code, you can also run each one by its command.
        </p>
      </div>
    </div>

    <ul class="home-features__skills" aria-label="Gleaner skills">
      {skills.map(skill => <SkillCard {...skill} />)}
    </ul>

    <div class="home-features__anatomy">
      <div class="home-features__head">
        <h3 class="home-features__subtitle">What's in every clip</h3>
        <p class="home-features__muted">
          About 400 words at most, in plain language: an HTML file in a Claude chat, or Markdown in
          ChatGPT and when it's saved to a folder or Drive. A title and details such as the source,
          date and tags come first. A page clip follows with a TL;DR, key points, notable details
          and takeaways. Videos get a channel line, a list of useful links and key moments from
          their transcript, or their chapters without one, in place of key points. Tutorial pages
          get numbered steps.
        </p>
      </div>

      <div class="home-features__clip-row">
        <figure class="home-features__clip">
          <figcaption>
            <span class="home-features__clip-label">Example</span>
            <span class="home-features__clip-path"
              >AI &amp; Agents / 2026-10-16-organize-work-with-projects.md</span
            >
          </figcaption>
          <!-- Markdown syntax is shown for the eye and hidden from screen
               readers, which hear the clip's fields instead of "star star". -->
          <div class="home-features__clip-body">
            <div class="home-features__line">
              <span class="home-features__marker" aria-hidden="true">1</span>
              <span class="home-features__strong"
                ><span class="home-features__syntax" aria-hidden="true"># </span>Organize work with
                projects</span
              >
            </div>
            <div class="home-features__line home-features__line--gap">
              <span class="home-features__marker" aria-hidden="true">2</span>
              <span
                ><span class="home-features__syntax" aria-hidden="true">**</span><span
                  class="home-features__strong">Source:</span
                ><span class="home-features__syntax" aria-hidden="true">**</span>
                {' '}https://claude.com/<wbr />docs/<wbr />cowork/<wbr />guide/<wbr />projects</span
              >
            </div>
            <div class="home-features__line">
              <span class="home-features__gutter" aria-hidden="true"></span>
              <span
                ><span class="home-features__syntax" aria-hidden="true">**</span><span
                  class="home-features__strong">Saved:</span
                ><span class="home-features__syntax" aria-hidden="true">**</span> 2026-10-16</span
              >
            </div>
            <div class="home-features__line">
              <span class="home-features__marker" aria-hidden="true">3</span>
              <span
                ><span class="home-features__syntax" aria-hidden="true">**</span><span
                  class="home-features__strong">Category:</span
                ><span class="home-features__syntax" aria-hidden="true">**</span> AI &amp; Agents</span
              >
            </div>
            <!-- The copper string carries marker 3 down over the type and tags,
                 which are filed with the category. -->
            <div class="home-features__line">
              <span class="home-features__gutter home-features__gutter--string" aria-hidden="true"
              ></span>
              <span
                ><span class="home-features__syntax" aria-hidden="true">**</span><span
                  class="home-features__strong">Type:</span
                ><span class="home-features__syntax" aria-hidden="true">**</span> docs</span
              >
            </div>
            <div class="home-features__line">
              <span
                class="home-features__gutter home-features__gutter--string home-features__gutter--end"
                aria-hidden="true"></span>
              <span
                ><span class="home-features__syntax" aria-hidden="true">**</span><span
                  class="home-features__strong">Tags:</span
                ><span class="home-features__syntax" aria-hidden="true">**</span> #cowork #claude-projects
                #local-files</span
              >
            </div>
            <div class="home-features__line">
              <span class="home-features__marker" aria-hidden="true">4</span>
              <span
                ><span class="home-features__syntax" aria-hidden="true">**</span><span
                  class="home-features__strong">Note:</span
                ><span class="home-features__syntax" aria-hidden="true">**</span>
                {' '}<mark>setting up page clipping</mark></span
              >
            </div>
            <div class="home-features__line home-features__line--gap">
              <span class="home-features__gutter" aria-hidden="true"></span>
              <span class="home-features__sections">
                {
                  ['TL;DR', 'Key points', 'Notable details', 'Takeaways'].map(heading => (
                    <span>
                      <span class="home-features__syntax" aria-hidden="true">
                        ##{' '}
                      </span>
                      <span class="home-features__strong">{heading}</span>{' '}
                      <span class="home-features__syntax">…</span>
                    </span>
                  ))
                }
              </span>
            </div>
          </div>
        </figure>

        <ol class="home-features__callouts" aria-label="What the numbered lines mean">
          {
            callouts.map((callout, i) => (
              <li>
                <span class="home-features__marker home-features__marker--large" aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <h4>{callout.title}</h4>
                  <p>{callout.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="home-features__destinations">
      <div class="home-features__destinations-head">
        <h3 class="home-features__subtitle">Saves where you already keep things</h3>
        <p class="home-features__muted">
          By default, each clip comes back in the chat, as a Markdown file in ChatGPT or an HTML
          file in Claude, and nothing is stored. Every save also shows a preview in the chat: an
          overview, key details, why it matters and links to the source and the clip. To store one,
          name the place or add{' '}
          <code class="home-features__inline-code">--to</code>. To store every clip, set a default
          with <code class="home-features__inline-code">/gleaner:preferences setup</code>.
        </p>
      </div>

      <ul class="home-features__places" aria-label="Destinations">
        {
          destinations.map(place => (
            <li>
              <strong>{place.name}</strong>
              <span class="home-features__where">
                {place.where.map(part => (
                  <span>{part}</span>
                ))}
              </span>
              <code class="home-features__chip">{place.flag}</code>
            </li>
          ))
        }
      </ul>

      <div class="home-features__foot">
        <p class="home-features__muted">
          Works in the Chrome side panel, the Browser pane in Claude Code desktop, and ChatGPT's
          connected Chrome tabs and Work browser.
        </p>
        <a class="home-features__guide" href={`${repo}#usage-guide`}>
          Read the usage guide
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18">
            <path
              d="M5 12h14M13 6l6 6-6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Two classes throughout: Astro scopes with `:where()`, so a lone class
     would lose to the site's own heading, list, code and link rules. */
  .home-features {
    background: var(--g-band, #fff);
    border-block-start: 1px solid var(--glean-border, #d5e3de);
    box-sizing: border-box;
    color: var(--g-ink, #12302b);
    container-type: inline-size;
    font-family: var(--font-family-sans, sans-serif);

    /* Full-bleed band, content on the hero's measure and edges. */
    padding-inline: max(1.25rem, calc((100% - var(--max-content-width, 80rem)) / 2));
    width: 100%;
  }

  /* Container units resolve against the band, so spacing tracks its width. */
  .home-features .home-features__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(4.5rem, 8cqi, 7rem);
    padding-block: clamp(4.5rem, 8cqi, 7rem) clamp(5rem, 9cqi, 8rem);
  }

  .home-features .home-features__intro {
    align-items: flex-end;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 4rem;
  }

  .home-features .home-features__title,
  .home-features .home-features__subtitle {
    color: var(--g-headline, #185c53);
    font-family: 'Plus Jakarta Sans', var(--font-family-display, sans-serif);
    font-weight: 800;
    margin: 0;
    min-width: 0;
    overflow-wrap: break-word;

    /* Sentences, not titles: the site capitalises every h2 and h3. */
    text-transform: none;
    text-wrap: balance;
  }

  .home-features .home-features__title {
    flex: 1 1 32.5rem;
    font-size: clamp(2.125rem, 4.4cqi, 3.5rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .home-features .home-features__subtitle {
    font-size: clamp(1.625rem, 2.6cqi, 2.125rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .home-features .home-features__lede {
    flex: 1 1 23.75rem;
    max-width: 32.5rem;
    min-width: 0;
  }

  .home-features .home-features__lede p {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0;
    max-width: none;
  }

  .home-features .home-features__lede .home-features__muted {
    font-size: 1rem;
    margin-block-start: 0.75rem;
  }

  .home-features .home-features__muted {
    color: var(--g-muted, #4a615c);
    line-height: 1.6;
  }

  /* @fpkit/acss stacks every list in a column; these lay out in rows. */
  .home-features .home-features__skills,
  .home-features .home-features__places {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .home-features .home-features__skills {
    gap: 1.5rem;
  }

  /* The gap spaces the cards. The site's 8px margin under every item but the
     last made the last card in a row taller than the rest, so its foot sat
     lower; the list owns its spacing, so it clears that here. */
  .home-features .home-features__skills > :global(li),
  .home-features .home-features__places > li {
    margin: 0;
  }

  /* A grid of up to two columns, so the four skills make an even two by two
     instead of three and one stretched alone. Each card shares its row's four
     tracks (head, title, description, phrases), so the phrase lists in a row
     start level even when one runs a line longer. */
  .home-features .home-features__skills {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .home-features .home-features__skills > :global(li) {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0;
  }

  /* The shared track lines the phrases up; the card's own pin to its foot
     would push the shorter list back down. */
  .home-features .home-features__skills :global(.skill-card__asks) {
    margin-block-start: 0;
  }

  /* Two columns once two cards fit at their 20rem, plus the gap. */
  @container (width >= 41.5rem) {
    .home-features .home-features__skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .home-features .home-features__anatomy {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .home-features .home-features__head {
    max-width: 40rem;
  }

  .home-features .home-features__head p {
    font-size: 1.0625rem;
    margin: 0.75rem 0 0;
    max-width: none;
  }

  .home-features .home-features__clip-row {
    align-items: flex-start;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 4rem;
  }

  .home-features .home-features__clip {
    background: var(--g-card, #f5f8f6);
    border: 1px solid var(--glean-border, #d5e3de);
    border-radius: 1rem;
    flex: 1 1 32.5rem;
    margin: 0;
    max-width: 42.5rem;
    min-width: 0;
    overflow: hidden;
  }

  .home-features .home-features__clip figcaption {
    align-items: center;
    border-block-end: 1px solid var(--glean-border, #d5e3de);
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    justify-content: space-between;
    letter-spacing: normal;
    padding: 0.75rem 1.25rem;
    text-transform: none;
  }

  .home-features .home-features__clip-label {
    color: var(--g-muted, #4a615c);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .home-features .home-features__clip-path {
    color: var(--g-ink, #12302b);
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    line-height: 1.5;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .home-features .home-features__clip-body {
    display: flex;
    flex-direction: column;
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 0.875rem;
    line-height: 1.5rem;
    padding: 1.25rem 1.5rem 1.5rem 1rem;
  }

  .home-features .home-features__line {
    align-items: flex-start;
    display: flex;
    gap: 0.75rem;
  }

  .home-features .home-features__line > :last-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .home-features .home-features__line--gap {
    margin-block-start: 0.75rem;
  }

  .home-features .home-features__gutter {
    align-self: stretch;
    flex: none;
    width: 1.375rem;
  }

  /* A 2px copper line centred in the gutter; the last one stops short. */
  .home-features .home-features__gutter--string {
    background: linear-gradient(var(--glean-string, #c46b43), var(--glean-string, #c46b43)) center /
      2px 100% no-repeat;
  }

  .home-features .home-features__gutter--end {
    background-size: 2px calc(100% - 0.375rem);
    background-position: center top;
  }

  .home-features .home-features__marker {
    background: var(--g-marker-bg, #9a4a26);
    border-radius: 999px;
    color: var(--g-marker-ink, #fff);
    flex: none;
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    height: 1.375rem;
    line-height: 1.375rem;
    margin-block-start: 1px;
    text-align: center;
    width: 1.375rem;
  }

  .home-features .home-features__marker--large {
    font-size: 0.8125rem;
    height: 1.75rem;
    line-height: 1.75rem;
    margin-block-start: 0;
    width: 1.75rem;
  }

  .home-features .home-features__syntax {
    color: var(--g-muted, #4a615c);
  }

  .home-features .home-features__strong {
    font-weight: 500;
  }

  .home-features .home-features__clip mark {
    background: var(--glean-mark-bg, #fbede5);
    border-radius: 0.25rem;
    box-decoration-break: clone;
    color: var(--glean-mark-ink, #12302b);
    padding: 1px 0.25rem;
  }

  .home-features .home-features__sections {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .home-features .home-features__callouts {
    display: flex;
    flex: 1 1 22.5rem;
    flex-direction: column;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    min-width: 0;
    padding: 0;
  }

  .home-features .home-features__callouts li {
    align-items: flex-start;
    display: flex;
    gap: 1rem;

    /* The list's gap spaces the callouts; clear the @fpkit/acss `li` margin
       and indent. */
    margin: 0;
    padding-inline-start: 0;
  }

  .home-features .home-features__callouts li > div {
    min-width: 0;
  }

  .home-features .home-features__callouts h4 {
    color: var(--g-ink, #12302b);
    font-size: 1.1875rem;
    line-height: 1.3;
    margin: 1px 0 0;
  }

  .home-features .home-features__callouts p {
    color: var(--g-muted, #4a615c);
    line-height: 1.6;
    margin: 0.375rem 0 0;
    max-width: none;
  }

  .home-features .home-features__destinations {
    border-block-start: 1px solid var(--glean-border, #d5e3de);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block-start: 3rem;
  }

  .home-features .home-features__destinations-head {
    align-items: flex-end;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 3rem;
    justify-content: space-between;
  }

  .home-features .home-features__destinations-head .home-features__subtitle {
    flex: 1 1 22.5rem;
  }

  .home-features .home-features__destinations-head p {
    flex: 1 1 22.5rem;
    margin: 0;
    max-width: 33.75rem;
    min-width: 0;
  }

  .home-features .home-features__places {
    gap: 1rem;
  }

  .home-features .home-features__places li {
    border: 1px solid var(--glean-border, #d5e3de);
    border-radius: 0.875rem;
    box-sizing: border-box;
    display: flex;
    flex: 1 1 12.5rem;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    padding: 1.25rem;
  }

  .home-features .home-features__places strong {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
  }

  /* Each path segment stays whole; the line breaks only between them. */
  .home-features .home-features__where {
    color: var(--g-muted, #4a615c);
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .home-features .home-features__where span {
    display: inline-block;
  }

  .home-features .home-features__chip,
  .home-features .home-features__inline-code {
    color: var(--g-headline, #185c53);
    font-family: var(--font-family-mono, ui-monospace, monospace);
    letter-spacing: normal;
    text-transform: none;
  }

  .home-features .home-features__chip {
    align-self: flex-start;
    background: var(--g-chip, #e3efeb);
    border-radius: 999px;
    font-size: 0.8125rem;
    line-height: 1.4;
    margin-block-start: auto;
    overflow-wrap: anywhere;
    padding: 0.25rem 0.75rem;
  }

  /* A flag never breaks at its hyphens. */
  .home-features .home-features__inline-code {
    background: none;
    font-size: 0.875rem;
    padding: 0;
    white-space: nowrap;
  }

  .home-features .home-features__foot {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    justify-content: space-between;
  }

  .home-features .home-features__foot p {
    flex: 1 1 26.25rem;
    margin: 0;
    max-width: none;
    min-width: 0;
  }

  .home-features .home-features__guide {
    align-items: center;
    color: var(--g-headline, #185c53);
    display: inline-flex;
