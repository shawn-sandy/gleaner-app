---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import MarkdownPostLayout from '#layouts/MarkdownPostLayout.astro'
import PostNav from '#components/astro/PostNav.astro'
import { adjacentPosts, readingMinutes } from '#utils/post-navigation'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map((entry: CollectionEntry<'posts'>) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

export type Props = {
  entry?: CollectionEntry<'posts'>
}

// Handle both static and dynamic rendering
let entry: CollectionEntry<'posts'>
if (Astro.props.entry) {
  // Static/prerendered context
  entry = Astro.props.entry
} else {
  // Server-rendered context - get entry from params
  const posts = await getCollection('posts')
  const foundEntry = posts.find(post => post.id === Astro.params.slug)
  if (!foundEntry) {
    return Astro.redirect('/404')
  }
  entry = foundEntry
}

const { Content, headings } = await render(entry)

const { older, newer } = adjacentPosts(await getCollection('posts'), entry.id)
/** The neighbour as `PostNav` links it. */
const link = (post: CollectionEntry<'posts'> | undefined) =>
  post && { id: post.id, title: post.data.title }
---

<MarkdownPostLayout
  frontmatter={entry.data}
  headings={headings}
  readingMinutes={readingMinutes(entry.body)}
>
  <Content />
  <PostNav older={link(older)} newer={link(newer)} />
</MarkdownPostLayout>
