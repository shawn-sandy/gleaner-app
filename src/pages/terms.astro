---
/** Public terms for Gleaner; available without signing in. */
export const prerender = true
import Layout from '#layouts/Layout.astro'

const privacyUrl =
  'https://github.com/shawn-sandy/gleaner/blob/30dd4fb4ab3deda20fb20c1557f40c9cd3998c49/plugins/gleaner/PRIVACY.md'
---

<Layout
  pageTitle="Terms of Service"
  pageDescription="Terms for using Gleaner, its skills, and its documentation."
  hideSidebar
>
  <p>Last updated: <time datetime="2026-11-03">November 3, 2026</time></p>

  <h2>About these terms</h2>
  <p>
    Gleaner is an open-source collection of assistant skills maintained by Shawn Jason Sandy,
    publicly known as Shawn Sandy. It helps you summarize and save web pages, videos, and other
    content through a compatible assistant and the tools you choose to connect.
  </p>
  <p>
    These terms describe your use of Gleaner and its documentation. By using them, you agree to
    these terms, subject to your rights under the applicable open-source licenses and laws. If you
    do not agree, stop using the service. Nothing here limits rights that the law does not allow to
    be waived.
  </p>

  <h2>Open-source license</h2>
  <p>
    Gleaner's source code is provided under the{' '}
    <a href="https://github.com/shawn-sandy/gleaner/blob/main/LICENSE">MIT License</a>. That license
    governs your rights to use, copy, modify, and distribute the software. These terms do not
    replace or restrict those rights. Third-party components and source content remain subject to
    their own licenses and terms.
  </p>

  <h2>Your content and responsibilities</h2>
  <p>
    You retain any rights you have in content you provide. These terms do not transfer ownership of
    your content to Gleaner's maintainer or grant you ownership of someone else's content. Only
    access, summarize, save, and share material you are permitted to use, and respect copyright,
