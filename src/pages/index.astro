---
import Layout from '../layouts/Layout.astro'
import Featured from '#components/astro/Featured.astro'
import HomeBlog from '#components/astro/HomeBlog.astro'
import HomeFeatures from '#components/astro/HomeFeatures.astro'
import HomeHero from '#components/astro/HomeHero.astro'
import HomeInstall from '#components/astro/HomeInstall.astro'
import HomeRequirements from '#components/astro/HomeRequirements.astro'
import HomeSectionNav from '#components/astro/HomeSectionNav.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '#utils/site-config.js'
---

<Layout
  pageTitle={SITE_TITLE}
  pageDescription={SITE_DESCRIPTION}
  showBreadcrumb={false}
  hideSidebar
>
  <HomeHero slot="header" />
  <HomeSectionNav slot="header" />
  <div slot="featured">
    <!-- <section>
      <Featured />
    </section> -->
    <HomeFeatures />
  </div>
  <HomeInstall />
  <HomeRequirements />
  <HomeBlog />
</Layout>

<style>
  /* `main > section` carries 2rem of inline padding, which set the install
     guide 32px in from the hero and features above it. This keeps it on the
     shared gutter, so its outer edges meet the features' edges: 1.25rem while
     the viewport is narrower than the measure, easing to 0 once main is
     centred with room to spare. Scoped through :has so it cannot reach another
     page's main. */
  :global(main:has(.home-install) > section) {
    padding-inline: clamp(
      0rem,
      calc((var(--max-content-width, 80rem) + 2.5rem - 100vw) / 2),
      1.25rem
    );
  }
</style>
